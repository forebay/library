{
  "alpha": {
    "id": "alpha",
    "label": "Alpha CLI",
    "home": {
      "envOverride": "HUB_ALPHA_DIR",
      "nativeEnv": "ALPHA_CONFIG_DIR",
      "candidates": [
        "~/.alpha",
        "~/.config/alpha"
      ]
    },
    "detect": {
      "binary": "alpha",
      "pkg": "alpha-cli"
    },
    "loader": {
      "id": "alpha-loader",
      "url": "acme-org/alpha-loader"
    },
    "commandsSubdir": "commands",
    "paths": {
      "repos": "repos",
      "plugin": "plugin",
      "cache": "cache",
      "config": "config"
    },
    "proxyPort": 40001,
    "integration": "env-baseurl",
    "wireFormat": "anthropic",
    "usage": {
      "formats": [
        "alpha-jsonl"
      ]
    }
  },
  "bad": {
    "id": "bad",
    "home": {
      "candidates": []
    }
  },
  "noLabel": {
    "home": {
      "candidates": [
        "~/.x"
      ]
    }
  },
  "labelNumber": {
    "label": 5,
    "home": {
      "candidates": [
        "~/.x"
      ]
    }
  },
  "emptyId": {
    "id": "",
    "label": "Empty",
