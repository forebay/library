{
  "beta": {
    "id": "beta",
    "label": "Beta CLI",
    "home": {
      "envOverride": "HUB_BETA_DIR",
      "nativeEnv": "BETA_CONFIG_DIR",
      "xdgSubdir": "beta",
      "candidates": [
        "~/.config/beta",
        "~/.beta"
      ]
    },
    "detect": {
      "binary": "beta",
      "pkg": "beta-cli"
    },
    "commandsSubdir": "command",
    "proxyPort": 40002,
    "integration": "native",
    "wireFormat": "anthropic"
  }
}
