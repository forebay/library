{
  "beta": {
    "id": "beta",
    "label": "Beta CLI",
    "home": {
      "envOverride": "HUB_BETA_DIR",
      "nativeEnv": "BETA_CONFIG_DIR",
      "xdgSubdir": "beta",
      "candidates": [
        "~/.config/beta",
        "~/.beta"
      ]
    },
    "detect": {
      "binary": "beta",
      "pkg": "beta-cli"
    },
    "commandsSubdir": "command",
    "proxyPort": 40002,
    "integration": "native",
    "wireFormat": "anthropic"
  },
  "gamma": {
    "id": "gamma",
    "label": "Gamma CLI",
    "home": {
      "candidates": [
        "{home}/gamma-dir"
      ]
    },
    "detect": {
      "binary": "gamma",
      "pkg": "gamma-cli"
    },
    "commandsSubdir": "commands",
    "paths": {
      "repos": "repos",
      "plugin": "plugin",
      "cache": "cache",
      "config": "config"
    },
    "proxyPort": 40003,
    "integration": "env-baseurl",
    "wireFormat": "anthropic"
  }
}
